---
import "../styles/globals.css";
import Hero from "../components/Hero.astro";
import Problem from "../components/Problem.astro";
import Solution from "../components/Solution.astro";
import Footer from "../components/Footer.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Aegis402 — on-chain governance for AI agents on Solana</title>
    <meta
      name="description"
      content="Programmable firewall for AI agents on Solana. PDA vaults, on-chain policy enforcement, x402-native middleware, operator dashboard."
    />
    <meta property="og:title" content="Aegis402" />
    <meta
      property="og:description"
      content="On-chain financial governance middleware for AI agents on Solana."
    />
    <meta property="og:type" content="website" />
  </head>
  <body>
    <main>
      <Hero />
      <Problem />
      <Solution />
    </main>
    <Footer />
  </body>
</html>
